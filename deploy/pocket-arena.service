[Unit]
Description=Pocket Arena Node/Express/Socket.IO server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pocketarena
Group=pocketarena
WorkingDirectory=/opt/pocket-arena/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/pocket-arena/pocket-arena.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/pocket-arena

[Install]
WantedBy=multi-user.target
